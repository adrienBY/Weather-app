{
  "name": "ciel-weather",
  "version": "1.0.0",
  "private": true,
  "description": "Ciel - a weather PWA with a live WebGL2 sky, wrapped as an Android app with Capacitor.",
  "type": "module",
  "scripts": {
    "build:web": "node scripts/build-web.mjs",
    "android:add": "cap add android",
    "android:patch": "node scripts/patch-android.mjs",
    "android:sync": "cap sync android",
    "android:apk": "cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@fontsource-variable/inter": "^5.3.0",
    "sharp": "^0.34.5"
  }
}
